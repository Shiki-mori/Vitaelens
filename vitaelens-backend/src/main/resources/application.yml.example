server:
  port: ${SERVER_PORT:8080}

spring:
  application:
    name: vitaelens-backend

  docker:
    compose:
      # 从 vitaelens-backend 模块启动时，compose 文件在项目根目录 deploy/ 下
      file: ../deploy/docker-compose.yml

  datasource:
    url: jdbc:mysql://localhost:3307/vitaelens?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
    username: vitaelens
    password: ${MYSQL_PASSWORD:your-mysql-password}
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: localhost
      port: 6379

system:
  admin:
    username: admin
    password: aStrongPassword

jwt:
  secret: ${JWT_SECRET:vitaelens-jwt-secret-key-change-in-production}
  # expiration: 86400000  # 24小时，单位毫秒
  expiration: 86400000000

vitaelens:
  upload-dir: ./uploads/resumes

ai:
  base-url: https://****
  api-key: ${AI_API_KEY:my-api-key}
  model: my-ai-model
  timeout-seconds: 60