name: vitaelens

services:
  mysql:
    image: mysql:8.0
    container_name: vitaelens-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-root123456}
      MYSQL_DATABASE: ${MYSQL_DATABASE:-vitaelens}
      MYSQL_USER: ${MYSQL_USER:-vitaelens}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-vitaelens123}
      TZ: Asia/Shanghai
    ports:
      - "${MYSQL_PORT:-3308}:3306"
    volumes:
      - ./mysql-data:/var/lib/mysql
      - ./mysql-init:/docker-entrypoint-initdb.d
    command:
      --default-authentication-plugin=mysql_native_password
      --character-set-server=utf8mb4
      --collation-server=utf8mb4_unicode_ci
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-u${MYSQL_USER:-vitaelens}", "-p${MYSQL_PASSWORD:-vitaelens123}"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - vitaelens

  redis:
    image: redis:7.2
    container_name: vitaelens-redis
    restart: unless-stopped
    ports:
      - "${REDIS_PORT:-6379}:6379"
    command: redis-server --appendonly yes
    volumes:
      - ./redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - vitaelens

  backend:
    build:
      context: ../vitaelens-backend
      dockerfile: Dockerfile
    container_name: vitaelens-backend
    restart: unless-stopped
    environment:
      SPRING_PROFILES_ACTIVE: prod
      SPRING_DATASOURCE_URL: jdbc:mysql://mysql:3306/${MYSQL_DATABASE:-vitaelens}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
      SPRING_DATASOURCE_USERNAME: ${MYSQL_USER:-vitaelens}
      SPRING_DATASOURCE_PASSWORD: ${MYSQL_PASSWORD:-vitaelens123}
      SPRING_DATA_REDIS_HOST: redis
      AI_BASE_URL: ${AI_BASE_URL}
      AI_API_KEY: ${AI_API_KEY}
      AI_MODEL: ${AI_MODEL:-my-ai-model}
      JWT_SECRET: ${JWT_SECRET}
    ports:
      - "${BACKEND_PORT:-8080}:8080"
    volumes:
      - uploads:/app/uploads/resumes
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - vitaelens

  frontend:
    build:
      context: ../vitaelens-frontend
      dockerfile: Dockerfile
    container_name: vitaelens-frontend
    restart: unless-stopped
    ports:
      - "${FRONTEND_PORT:-8088}:80"
    depends_on:
      - backend
    networks:
      - vitaelens

volumes:
  uploads:

networks:
  vitaelens:
    driver: bridge
